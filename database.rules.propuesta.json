{
  "rules": {
    "gastrogoan": {
      ".read": false,
      ".write": false,
      "tenants": {
        "$tenantId": {
          ".read": "auth != null && $tenantId.length >= 4 && $tenantId.length <= 60",
          ".write": "auth != null && $tenantId.length >= 4 && $tenantId.length <= 60"
        }
      },
      "publicLookup": {
      "$publicId": {
        ".read": true,
        ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && (!data.exists() || (data.child('apiKey').val() === newData.child('apiKey').val() && data.child('databaseURL').val() === newData.child('databaseURL').val()) || auth.token.email === 'gastrogoan@gmail.com')",
        ".validate": "newData.hasChildren(['apiKey','databaseURL'])"
      }
    },
    "public": {
        "$publicId": {
          "info": {
            ".read": "auth != null",
            ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30"
          },
          "requests": {
            ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
            "$requestId": {
              ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && (!data.exists() || (!newData.exists() && data.child('_claimedAt').exists()))",
              ".validate": "newData.hasChildren(['type', 'createdAt']) && newData.child('type').isString() && (newData.child('type').val() === 'reserva' || newData.child('type').val() === 'pedido' || newData.child('type').val() === 'nps_response' || newData.child('type').val() === 'reserva_cancelar' || newData.child('type').val() === 'reserva_modificar' || newData.child('type').val() === 'pedido_mesa' || newData.child('type').val() === 'pago_mesa' || newData.child('type').val() === 'pedido_aviso') && (!newData.child('uid').exists() || (newData.child('uid').isString() && newData.child('uid').val() === auth.uid)) && (!newData.child('slot').exists() || (newData.child('slot').isString() && newData.child('slot').val().matches(/^m([0-9]|1[01])$/)))",
              "_claimedAt": {
                ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && data.parent().exists() && !data.exists()",
                ".validate": "newData.isNumber()"
              }
            }
          },
          "aforoHold": {
            ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
            "$dateStr": {
              "$turnoIdx": {
                ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500 && ((!data.exists() && newData.val() <= (root.child('gastrogoan/public/'+$publicId+'/info/business/reservaConfirmManualDesde').isNumber() && root.child('gastrogoan/public/'+$publicId+'/info/business/reservaConfirmManualDesde').val() > 1 && root.child('gastrogoan/public/'+$publicId+'/info/business/reservaConfirmManualDesde').val() <= 51 ? root.child('gastrogoan/public/'+$publicId+'/info/business/reservaConfirmManualDesde').val() - 1 : 50)) || (data.exists() && newData.val() <= data.val() + (root.child('gastrogoan/public/'+$publicId+'/info/business/reservaConfirmManualDesde').isNumber() && root.child('gastrogoan/public/'+$publicId+'/info/business/reservaConfirmManualDesde').val() > 1 && root.child('gastrogoan/public/'+$publicId+'/info/business/reservaConfirmManualDesde').val() <= 51 ? root.child('gastrogoan/public/'+$publicId+'/info/business/reservaConfirmManualDesde').val() - 1 : 50)))"
              }
            }
          },
          "pedidosHold": {
            ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
            "$dateStr": {
              "$slot": {
                ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500 && ((!data.exists() && newData.val() <= 1) || (data.exists() && newData.val() <= data.val() + 1))"
              }
            }
          },
          "mesaHold": {
            ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
            "$dateStr": {
              "$tableId": {
                ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
                "$slot": {
                  ".validate": "newData.isBoolean() && newData.val() === true"
                }
              }
            }
          },
          "orderStatus": {
            ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
            "$token": {
              ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && $token.length >= 12",
              ".validate": "newData.hasChildren(['status', 'updatedAt']) && newData.child('status').isString() && newData.child('status').val().length <= 20"
            }
          },
          "reservationStatus": {
            ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
            "$token": {
              ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && $token.length >= 12",
              ".validate": "newData.hasChildren(['status', 'updatedAt']) && newData.child('status').isString() && newData.child('status').val().length <= 20"
            }
          },
          "mesaQr": {
            "$token": {
              ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && $token.length >= 16 && $token.length <= 64",
              ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && $token.length >= 16 && $token.length <= 64",
              ".validate": "newData.hasChildren(['mesa', 'updatedAt']) && newData.child('mesa').isString() && newData.child('mesa').val().length <= 60"
            }
          },
          "mesaGrupo": {
            "$token": {
              ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && $token.length >= 16 && $token.length <= 64 && root.child('gastrogoan/public/'+$publicId+'/mesaQr/'+$token+'/grupo').val() === true",
              ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && $token.length >= 16 && $token.length <= 64 && !newData.exists() && root.child('gastrogoan/public/'+$publicId+'/mesaQr/'+$token+'/grupo').val() !== true",
              "miembros": {
                "$slot": {
                  ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && $token.length >= 16 && $token.length <= 64 && root.child('gastrogoan/public/'+$publicId+'/mesaQr/'+$token+'/grupo').val() === true && !root.child('gastrogoan/public/'+$publicId+'/mesaQr/'+$token+'/expulsados/'+$slot).exists() && (!data.exists() || data.child('uid').val() === auth.uid || data.child('ts').val() < now - 28800000)",
                  ".validate": "$slot.matches(/^m([0-9]|1[01])$/) && newData.hasChildren(['uid', 'n', 'ts']) && newData.child('uid').val() === auth.uid && newData.child('uid').isString() && newData.child('n').isString() && newData.child('n').val().length >= 1 && newData.child('n').val().length <= 30 && newData.child('ts').isNumber()",
                  "$otro": {
                    ".validate": "$otro === 'uid' || $otro === 'n' || $otro === 'ts'"
                  }
                }
              },
              "carritos": {
                "$slot": {
                  ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && $token.length >= 16 && $token.length <= 64 && root.child('gastrogoan/public/'+$publicId+'/mesaQr/'+$token+'/grupo').val() === true && !root.child('gastrogoan/public/'+$publicId+'/mesaQr/'+$token+'/expulsados/'+$slot).exists() && $slot.matches(/^m([0-9]|1[01])$/) && root.child('gastrogoan/public/'+$publicId+'/mesaGrupo/'+$token+'/miembros/'+$slot+'/uid').val() === auth.uid",
                  "$linea": {
                    ".validate": "$linea.matches(/^l([0-9]|[12][0-9])$/) && newData.hasChildren(['p', 'q']) && newData.child('p').isString() && newData.child('p').val().length <= 60 && newData.child('q').isNumber() && newData.child('q').val() >= 1 && newData.child('q').val() <= 20 && (!newData.child('m').exists() || (newData.child('m').isString() && newData.child('m').val().length <= 120)) && (!newData.child('r').exists() || (newData.child('r').isString() && newData.child('r').val().length <= 60))",
                    "$otro": {
                      ".validate": "$otro === 'p' || $otro === 'q' || $otro === 'm' || $otro === 'r'"
                    }
                  }
                }
              }
            }
          },
          "reservationLookup": {
            "$lookupKey": {
              ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
              "$token": {
                ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && $token.length >= 12",
                ".validate": "newData.isBoolean() && newData.val() === true"
              }
            }
          }
        }
      },
      "publicSlugs": {
        "$slug": {
          ".read": true,
          ".write": "auth != null && $slug.length >= 2 && $slug.length <= 40 && (!data.exists() || data.val() === newData.val() || auth.token.email === 'gastrogoan@gmail.com')",
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 30"
        }
      },

      "tenantLookup": {
        "$tenantId": {
          ".read": "auth != null && $tenantId.length >= 4 && $tenantId.length <= 60",
          ".write": "auth != null && $tenantId.length >= 4 && $tenantId.length <= 60 && (!data.exists() || (newData.exists() && data.child('databaseURL').val() === newData.child('databaseURL').val()) || auth.token.email === 'gastrogoan@gmail.com')",
          ".validate": "newData.hasChildren(['apiKey', 'databaseURL']) && newData.child('apiKey').isString() && newData.child('databaseURL').isString() && newData.child('databaseURL').val().length <= 300"
        }
      },

      "issuedCodes": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email === 'gastrogoan@gmail.com' && $code.length == 8 && (!data.exists() || !newData.exists())"
        }
      },
      "revokedCodes": {
        "$code": {
          ".read": "auth != null && $code.length == 8",
          ".write": "auth != null && auth.token.email === 'gastrogoan@gmail.com' && $code.length == 8"
        }
      },

      "ownerNames": {
        "$user": {
          ".read": "auth != null && auth.token.email === 'gastrogoan@gmail.com'",
          ".write": "auth != null && auth.token.email === 'gastrogoan@gmail.com' && $user.length <= 40"
        }
      },

      "ownerAuth": {
        "$authKey": {
          ".read": "auth != null && $authKey.length >= 16",

          ".write": "auth != null && $authKey.length >= 16 && (auth.token.email === 'gastrogoan@gmail.com' || !newData.exists() || (!data.exists() && newData.hasChild('user') && root.child('gastrogoan/ownerNames').child(newData.child('user').val()).exists()))",

          "businesses": {
            "$tenantId": {
              ".write": "auth != null && $authKey.length >= 16 && $tenantId.length >= 4 && $tenantId.length <= 60",
              ".validate": "newData.hasChild('code') && newData.child('code').isString() && newData.child('code').val().length <= 16"
            }
          }
        }
      },

      "codeClaims": {
        "$code": {
          ".read": "auth != null && $code.length == 8",
          ".write": "auth != null && $code.length == 8 && (!data.exists() || auth.token.email === 'gastrogoan@gmail.com')",
          ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 40"
        }
      },

      "adminSalesLog": {
        ".read": "auth != null && auth.token.email === 'gastrogoan@gmail.com'",
        ".write": "auth != null && auth.token.email === 'gastrogoan@gmail.com'"
      },

      "coachConfig": {

        ".read": "auth != null && auth.token.email === 'gastrogoan@gmail.com'",

        ".write": "auth != null && auth.token.email === 'gastrogoan@gmail.com'"

      },

      "pagos": {

        "$publicId": {

          "$ref": {

            ".read": "$ref.length >= 8"

          }

        }

      }
    }
  }
}
