{
  "rules": {
    "gastrogoan": {
      ".read": false,
      ".write": false,
      "tenants": {
        "$tenantId": {
          ".read": "auth != null && $tenantId.length >= 4 && $tenantId.length <= 60",
          ".write": "auth != null && $tenantId.length >= 4 && $tenantId.length <= 60"
        }
      },
      "public": {
        "$publicId": {
          "info": {
            ".read": "auth != null",
            ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30"
          },
          "requests": {
            ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
            "$requestId": {
              ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30 && !data.exists()",
              ".validate": "newData.hasChildren(['type', 'createdAt']) && newData.child('type').isString() && (newData.child('type').val() === 'reserva' || newData.child('type').val() === 'pedido' || newData.child('type').val() === 'nps_response')"
            }
          },
          "aforoHold": {
            ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
            "$dateStr": {
              "$turnoIdx": {
                ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
              }
            }
          },
          "pedidosHold": {
            ".read": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
            "$dateStr": {
              "$slot": {
                ".write": "auth != null && $publicId.length >= 4 && $publicId.length <= 30",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
              }
            }
          }
        }
      },
      "issuedCodes": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email === 'gastrogoan@gmail.com' && $code.length == 8 && !data.exists()"
        }
      },

      "ownerNames": {
        "$user": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email === 'gastrogoan@gmail.com' && $user.length <= 40"
        }
      },

      "ownerAuth": {
        "$authKey": {
          ".read": "auth != null && $authKey.length >= 16",
          ".write": "auth != null && auth.token.email === 'gastrogoan@gmail.com' && $authKey.length >= 16",
          "businesses": {
            "$tenantId": {
              ".write": "auth != null && $authKey.length >= 16 && $tenantId.length >= 4 && $tenantId.length <= 60",
              ".validate": "newData.hasChild('code') && newData.child('code').isString() && newData.child('code').val().length <= 16"
            }
          }
        }
      },

      "codeClaims": {
        "$code": {
          ".read": "auth != null && $code.length == 8",
          ".write": "auth != null && $code.length == 8 && (!data.exists() || auth.token.email === 'gastrogoan@gmail.com')",
          ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 40"
        }
      }
    }
  }
}
