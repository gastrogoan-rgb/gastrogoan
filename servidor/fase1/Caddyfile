# GastroGoan · FASE 1 (solo la web de reservas en IP propia).
# Motivo: los bloqueos de LaLiga caen sobre IP de Cloudflare. Esta web es lo que
# el cliente final necesita para reservar. La app, el panel y los pagos siguen en
# Cloudflare hasta comprobar en un partido que este servidor responde.
# Caddy obtiene y renueva solo el certificado HTTPS.

(reservas) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		# CSP: la MISMA que deploy/reservas/public/_headers (test/csp.mjs lo exige). frame-ancestors https: = se puede incrustar en la web del restaurante.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasedatabase.app wss://*.firebasedatabase.app https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://gastro.gastrogoan.workers.dev; frame-src 'self' blob: data: https://*.firebaseapp.com; worker-src 'self'; manifest-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https:"
		-Server
	}
	# Se puede incrustar en la web del restaurante: SIN X-Frame-Options (igual que _headers).
	@html path *.html / /sw-reservas.js
	header @html Cache-Control "no-cache"
	@fuentes path /fonts/*
	header @fuentes Cache-Control "public, max-age=31536000, immutable"

	root * /srv/gastrogoan/sitios/reservas
	# Enlace corto reservas.gastrogoan.com/casapaco: cualquier ruta que no sea un fichero
	# devuelve la misma página, como hace el 404.html de Pages.
	try_files {path} /index.html
	file_server
}

# El nombre de verdad. No se usa hasta que se cambie el DNS.
reservas.gastrogoan.com {
	import reservas
}

# Dirección de PRUEBA con la IP del servidor (x-x-x-x.sslip.io), generada al arrancar:
# permite abrir la web desde el móvil o la tablet con certificado válido ANTES de tocar el DNS.
import extra/*.caddy
